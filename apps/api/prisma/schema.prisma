// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  DEVELOPER
}

model User {
  id                    String        @id @default(cuid())
  email                 String        @unique
  displayName           String?
  passwordHash          String
  role                  Role          @default(DEVELOPER)
  refreshTokenHash      String?
  refreshTokenExpiresAt DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  boards                Board[]
  memberships           BoardMember[]
  assignments           CardMember[]
  comments              Comment[]
  timeEntries           TimeEntry[]
  attachments           Attachment[]
  events                Event[]
  notifications         Notification[]
}

model Board {
  id          String        @id @default(cuid())
  title       String
  owner       User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId     String
  inviteToken String?       @unique
  lists       List[]
  members     BoardMember[]
  labels      Label[]
  events      Event[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([ownerId])
}

model List {
  id        String   @id @default(cuid())
  title     String
  position  Float
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  boardId   String
  cards     Card[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([boardId])
}

model Card {
  id          String       @id @default(cuid())
  title       String
  description String?
  dueDate     DateTime?
  dueDone     Boolean      @default(false)
  position    Float
  list        List         @relation(fields: [listId], references: [id], onDelete: Cascade)
  listId      String
  assignees   CardMember[]
  labels      CardLabel[]
  comments    Comment[]
  timeEntries TimeEntry[]
  attachments Attachment[]
  checklist   ChecklistItem[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([listId])
}

model ChecklistItem {
  id       String  @id @default(cuid())
  text     String
  done     Boolean @default(false)
  position Float
  card     Card    @relation(fields: [cardId], references: [id], onDelete: Cascade)
  cardId   String

  @@index([cardId])
}

model Label {
  id      String      @id @default(cuid())
  name    String
  color   String
  board   Board       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  boardId String
  cards   CardLabel[]

  @@index([boardId])
}

model CardLabel {
  card    Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  cardId  String
  label   Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)
  labelId String

  @@id([cardId, labelId])
  @@index([labelId])
}

model Comment {
  id        String   @id @default(cuid())
  body      String
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  cardId    String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  createdAt DateTime @default(now())

  @@index([cardId])
}

model TimeEntry {
  id        String   @id @default(cuid())
  date      DateTime // day-level: what day the work happened, not when it was logged
  hours     Float
  note      String?
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  cardId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@index([cardId])
}

model Attachment {
  id           String   @id @default(cuid())
  path         String // random filename on disk; unguessable, doubles as the access token
  originalName String
  size         Int
  card         Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  cardId       String
  uploader     User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  uploaderId   String
  createdAt    DateTime @default(now())

  @@index([cardId])
}

model BoardMember {
  board    Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  boardId  String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String
  joinedAt DateTime @default(now())

  @@id([boardId, userId])
  @@index([userId])
}

model CardMember {
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  cardId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@id([cardId, userId])
  @@index([userId])
}

// Append-only activity log. One row feeds three readers: the live stream (SSE),
// the per-card activity feed, and notification fan-out. See docs/adr/0003.
model Event {
  id      String @id @default(cuid())
  // Plain string, not an enum: a new event type shouldn't cost a migration.
  type    String
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  boardId String
  // Deliberately NOT a relation: "deleted card X" has to outlive card X.
  // `data` carries a title snapshot so the feed still renders after the card is gone.
  cardId  String?
  actor   User   @relation(fields: [actorId], references: [id], onDelete: Cascade)
  actorId String
  // Display-only snapshot (titles, list names, label name). Never read back as state.
  data          Json
  createdAt     DateTime       @default(now())
  notifications Notification[]

  @@index([boardId, createdAt])
  @@index([cardId, createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  event     Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId   String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  // Makes fan-out idempotent: a retried record() can't double-notify.
  @@unique([userId, eventId])
  @@index([userId, readAt])
}
